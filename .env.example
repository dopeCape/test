# SHA-256 hex digest of your login password.
# Generate with: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
APP_PASSWORD_HASH=

# Random secret used to sign the session cookie. Min 16 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
